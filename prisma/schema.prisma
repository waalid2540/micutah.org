// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String?
  role          String      @default("USER") // USER, ADMIN, VENDOR
  listings      Listing[]
  donations     Donation[]
  quizScores    QuizScore[]
  vendors       Vendor[]
  reviews       Review[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PrayerTimes {
  id            String   @id @default(cuid())
  date          DateTime @unique
  fajr          String
  sunrise       String
  dhuhr         String
  asr           String
  maghrib       String
  isha          String
  // Iqamah times (set by admin)
  fajrIqamah    String?
  dhuhrIqamah   String?
  asrIqamah     String?
  maghribIqamah String?
  ishaIqamah    String?
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  endDate     DateTime?
  location    String?
  image       String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  type      String   // ZAKAT, SADAQAH, MASJID_FUND, RAMADAN, IFTAR
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  name      String
  phone     String?
  recurring Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// ============== HALAL MARKETPLACE ==============

model Vendor {
  id              String   @id @default(cuid())
  
  // Business Info
  businessName    String
  slug            String   @unique
  description     String?
  logo            String?
  coverImage      String?
  
  // Contact
  email           String
  phone           String
  whatsapp        String?
  website         String?
  
  // Location
  address         String?
  city            String?
  state           String   @default("UT")
  zipCode         String?
  serviceArea     String?  // "Salt Lake City" or "Nationwide"
  
  // Verification
  status          String   @default("pending") // pending, approved, rejected, suspended
  verifiedBy      String?  // masjid that verified them
  verifiedAt      DateTime?
  halalCertified  Boolean  @default(false)
  certificationDoc String?
  
  // Owner
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  // Relations
  listings        Listing[]
  reviews         Review[]
  
  // Stats
  totalSales      Int      @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  
  // Subscription
  plan            String   @default("free") // free, featured, premium
  planExpiresAt   DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ListingCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  listings    Listing[]
}

model Listing {
  id          String   @id @default(cuid())
  
  // Basic Info
  title       String
  slug        String   @unique
  description String
  
  // Pricing
  price       Float?
  priceLabel  String?  // "per hour", "per dozen", "Contact for quote"
  priceType   String   @default("fixed") // fixed, negotiable, free, contact
  
  // Category
  categoryId  String?
  category    ListingCategory? @relation(fields: [categoryId], references: [id])
  categoryName String   // Denormalized for quick display
  
  // Type
  listingType String   @default("product") // product, service, job, housing, event
  
  // Media
  images      String?  // JSON array of image URLs
  
  // Contact (for non-vendor listings)
  contactName String?
  contactPhone String?
  contactEmail String?
  contactWhatsapp String?
  
  // Vendor (if vendor listing)
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  
  // Legacy user relation
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  
  // Status
  status      String   @default("pending") // pending, approved, rejected, expired, sold
  featured    Boolean  @default(false)
  featuredUntil DateTime?
  
  // Location
  city        String?
  state       String   @default("UT")
  
  // Engagement
  views       Int      @default(0)
  inquiries   Int      @default(0)
  
  // Timestamps
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Legacy field mappings
  approved    Boolean  @default(false)
  contact     String?
  phone       String?
  image       String?
}

model Review {
  id          String   @id @default(cuid())
  
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  rating      Int      // 1-5
  title       String?
  comment     String?
  
  verified    Boolean  @default(false) // Did they actually transact?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([vendorId, userId]) // One review per user per vendor
}

model MarketplaceInquiry {
  id          String   @id @default(cuid())
  
  listingId   String
  
  // Inquirer info
  name        String
  email       String
  phone       String?
  message     String
  
  // Status
  status      String   @default("new") // new, responded, closed
  
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  author      String
  category    String   @default("general")
  image       String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quiz {
  id          String      @id @default(cuid())
  title       String
  description String?
  level       String      // BEGINNER, ADVANCED
  category    String      @default("general")
  questions   Question[]
  scores      QuizScore[]
  createdAt   DateTime    @default(now())
}

model Question {
  id       String @id @default(cuid())
  quizId   String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question String
  options  String // JSON array of options
  answer   Int    // Index of correct option (0-based)
  order    Int    @default(0)
}

model QuizScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  score     Int
  total     Int
  createdAt DateTime @default(now())
}

model IftarSponsorship {
  id        String   @id @default(cuid())
  date      DateTime
  sponsor   String
  email     String
  phone     String?
  amount    Float
  message   String?
  anonymous Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RamadanDonation {
  id        String   @id @default(cuid())
  amount    Float
  name      String
  email     String
  phone     String?
  anonymous Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
