// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String?
  role          String      @default("USER") // USER, ADMIN
  listings      Listing[]
  donations     Donation[]
  quizScores    QuizScore[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PrayerTimes {
  id            String   @id @default(cuid())
  date          DateTime @unique
  fajr          String
  sunrise       String
  dhuhr         String
  asr           String
  maghrib       String
  isha          String
  // Iqamah times (set by admin)
  fajrIqamah    String?
  dhuhrIqamah   String?
  asrIqamah     String?
  maghribIqamah String?
  ishaIqamah    String?
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  endDate     DateTime?
  location    String?
  image       String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  type      String   // ZAKAT, SADAQAH, MASJID_FUND, RAMADAN, IFTAR
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  name      String
  phone     String?
  recurring Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float?
  category    String
  contact     String
  phone       String?
  image       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  approved    Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  author      String
  category    String   @default("general")
  image       String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quiz {
  id          String      @id @default(cuid())
  title       String
  description String?
  level       String      // BEGINNER, ADVANCED
  category    String      @default("general")
  questions   Question[]
  scores      QuizScore[]
  createdAt   DateTime    @default(now())
}

model Question {
  id       String @id @default(cuid())
  quizId   String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question String
  options  String // JSON array of options
  answer   Int    // Index of correct option (0-based)
  order    Int    @default(0)
}

model QuizScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  score     Int
  total     Int
  createdAt DateTime @default(now())
}

model IftarSponsorship {
  id        String   @id @default(cuid())
  date      DateTime
  sponsor   String
  email     String
  phone     String?
  amount    Float
  message   String?
  anonymous Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RamadanDonation {
  id        String   @id @default(cuid())
  amount    Float
  name      String
  email     String
  phone     String?
  anonymous Boolean  @default(false)
  stripeId  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
